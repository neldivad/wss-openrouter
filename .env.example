# Copy this file to `.env.local` and fill in real values:
#
#     cp .env.example .env.local
#
# `.env.local` is gitignored and must NEVER be committed.

# An email a publisher can reach you at; goes in the User-Agent of every request.
WSS_CONTACT=you@example.com

# OpenRouter Data API key. IMPORTANT: this is the SAME key that authorises
# paid inference on your account — anyone who obtains it can spend your
# credits. Create a dedicated key for this repo at
# https://openrouter.ai/settings/keys and set a spend limit on it.
WSS_OPENROUTER_KEY=
