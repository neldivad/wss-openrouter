# Copy this file to `.env.local` and fill in real values:
#
#     cp .env.example .env.local
#
# `.env.local` is gitignored and must NEVER be committed.

# Who is running this capture, shown in the User-Agent so a publisher can reach
# you instead of silently blocking. A repo URL identifies you with no personal
# data; an email works too. Every fork must set its own.
WSS_CONTACT=https://github.com/neldivad/wss-openrouter

# OpenRouter Data API key. IMPORTANT: this is the SAME key that authorises
# paid inference on your account — anyone who obtains it can spend your
# credits. Create a dedicated key for this repo at
# https://openrouter.ai/settings/keys and set a spend limit on it.
OPENROUTER_API_KEY=
